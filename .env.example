# SoundCloud (OAuth from browser devtools on soundcloud.com)
SC_OAUTH_TOKEN=OAuth 2-...
SC_USER_ID=your_numeric_user_id
# SC_CLIENT_ID=...   # optional; public web client id works for many calls

# Duration filter: strictly between 2 and 10 minutes (defaults in download_likes.py)
# SC_MIN_DURATION_MS=120001
# SC_MAX_DURATION_MS=599999

# MTP sync tuning
# MTP_REMOUNT_EVERY=12
# MTP_COPY_TIMEOUT=240
# WALKMAN_MUSIC_ROOT=/run/user/1000/gvfs/mtp:host=.../Storage Media/MUSIC
